# Copy to .env and fill in. .env is ignored by git.
# The passport preview runs without any of these. They are only needed for
# accounts, saved renders, and the video render API.

# Render API base URL
VITE_API_GATEWAY_URL=

# Magic (passwordless email login)
VITE_MAGIC_PUBLISHABLE_KEY=
MAGIC_SECRET_KEY=

# AWS (signed URLs for saved renders)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Postgres (users and favorites)
DATABASE_URL=
